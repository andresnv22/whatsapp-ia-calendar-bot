# Modo demo (true = simula respuestas y calendario sin API keys reales)
DEMO_MODE=true

# IA (OpenAI o compatible)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=mi_token_secreto

# Google Calendar (ruta al JSON de Service Account y ID del calendario)
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_ID=primary
